{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ionic run (ext device)",
      "type": "shell",
      "command": "ionic",
      "args": [ "capacitor", "run", "android", "--livereload", "--external", "--target=${input:getDeviceID}" ],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}",
      },
      "presentation": {
        "focus": true,
        "reveal": "always",
        "echo": true,
        "panel": "shared",
      },
      // "dependsOn": "Android fix permissions",
    },
    {
      "label": "Android fix permissions",
      "type": "shell",
      "command": "adb",
      "args": [ "shell", "su", "-c", "'chmod +r /proc/net/unix'" ],
      "presentation": {
        "focus": true,
        "close": true,
        "reveal": "never",
        "revealProblems": "onProblem"
      }
    },
    {
      "label": "Ionic serve (localhost)",
      "type": "shell",
      "command": "ionic",
      "args": [ "serve", "--port=8100", "--host=localhost"],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}",
      },
      "presentation": {
        "focus": true,
        "reveal": "always",
        "echo": true,
        "panel": "shared",
      },
    }
  ],
  "inputs": [
    {
      // This trick forces VS Code to dynamically execute a script to fetch the variable on every F5
      "id": "getDeviceID",
      "type": "command",
      "command": "extension.commandvariable.file.content",
      "args": {
        "fileName": "${workspaceFolder}/.env",
        "key": "ANDROID_DEVICE_ID",
        "default": "Please-set-the-android-device-key-in-.env-file"
      }
    }
  ]
}