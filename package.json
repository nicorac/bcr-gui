{
  "name": "bcrgui",
  "version": "0.0.0",
  "author": "Claudio Nicora",
  "description": "BCR-GUI is a companion app for BCR (Basic Call Recorder)",
  "homepage": "https://github.com/nicorac/bcr-gui",
  "scripts": {
    "ng": "ng",
    "prestart": "adb shell \"su -c 'chmod +r /proc/net/unix'\"",
    "start": "ionic serve",
    "build": "ng build",
    "fix-android-permissions": "adb shell su -c chmod a+rw /proc/net/unix",
    "check-i18n-files": "node -r ts-node/register scripts/check-i18n-files.ts",
    "prebuild:android": "node scripts/check-android-version.js",
    "build:android": "ionic capacitor build android --no-open --prod && cd android && gradlew assembleRelease && cd ..",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "update-all-packages": "npm install --save $(npm outdated | cut -d \" \" -f -1 | sed '1d' | sed 's/$/@*/')",
    "generate-assets": "npx capacitor-assets generate --assets-path app/src/assets/icons --android",
    "open-android-studio": "npx cap open android"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.9",
    "@angular/common": "21.2.11",
    "@angular/core": "21.2.11",
    "@angular/forms": "21.2.11",
    "@angular/platform-browser": "21.2.11",
    "@angular/platform-browser-dynamic": "21.2.11",
    "@angular/router": "21.2.11",
    "@capacitor-community/contacts": "7.2.0",
    "@capacitor/android": "8.3.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.3.1",
    "@capacitor/device": "8.0.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@capgo/capacitor-navigation-bar": "8.1.5",
    "@ionic/angular": "8.8.5",
    "capacitor-native-settings": "8.1.0",
    "filesize": "11.0.17",
    "ionicons": "8.0.13",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.9",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/cli": "21.2.9",
    "@angular/compiler": "21.2.11",
    "@angular/compiler-cli": "21.2.11",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.3.1",
    "@ionic/angular-toolkit": "12.3.0",
    "@types/jasmine": "6.0.0",
    "@types/node": "24.12.2",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract@3.0.3": true,
    "sharp": true
  },
  "engines": {
    "npm": ">= 10.9.0",
    "node": ">= 22.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.3": true,
    "sharp@0.32.6": true
  }
}
