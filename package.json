{
  "name": "bcrgui",
  "version": "0.0.0",
  "author": "Claudio Nicora",
  "description": "BCR-GUI is a companion app for BCR (Basic Call Recorder)",
  "homepage": "https://github.com/nicorac/bcr-gui",
  "scripts": {
    "ng": "ng",
    "prestart": "adb shell \"su -c 'chmod +r /proc/net/unix'\"",
    "start": "ionic serve",
    "build": "ng build",
    "fix-android-permissions": "adb shell su -c chmod a+rw /proc/net/unix",
    "check-i18n-files": "node -r ts-node/register scripts/check-i18n-files.ts",
    "prebuild:android": "node scripts/check-android-version.js",
    "build:android": "ionic capacitor build android --no-open --prod && cd android && gradlew assembleRelease && cd ..",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "update-all-packages": "npm install --save $(npm outdated | cut -d \" \" -f -1 | sed '1d' | sed 's/$/@*/')",
    "generate-assets": "npx capacitor-assets generate --assets-path app/src/assets/icons --android",
    "open-android-studio": "npx cap open android"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-browser-dynamic": "22.1.7",
    "@angular/router": "22.1.7",
    "@capacitor-community/contacts": "8.0.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-navigation-bar": "8.2.10",
    "@ionic/angular": "^9.0.4",
    "capacitor-native-settings": "8.2.0",
    "filesize": "11.0.24",
    "ionicons": "8.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@ionic/angular-toolkit": "13.0.0",
    "@types/jasmine": "6.0.0",
    "@types/node": "24.13.5",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "50.4.3",
    "istanbul-lib-instrument": "^6.0.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "sharp": true,
    "@parcel/watcher@2.6.0": true,
    "msgpackr-extract@3.0.4": true
  },
  "engines": {
    "npm": ">= 10.9.0",
    "node": ">= 24.15.0"
  }
}
